{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchthrough.dev/schemas/transcript-raw-v1.schema.json",
  "title": "Patchthrough recoverable raw hypotheses",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_version", "quality_mode", "created_at", "tracks"],
  "properties": {
    "schema_version": {"const": 1},
    "pipeline_version": {"const": 2},
    "quality_mode": {"enum": ["standard", "max_accuracy"]},
    "created_at": {"type": "string", "format": "date-time"},
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_track", "speaker", "offset_ms", "audio_file", "hypotheses", "selected_hypothesis"],
        "properties": {
          "source_track": {"enum": ["mic", "system"]},
          "speaker": {"enum": ["me", "them"]},
          "offset_ms": {"type": "integer", "minimum": 0},
          "audio_file": {"type": "string", "minLength": 1},
          "hypotheses": {"type": "array", "minItems": 1, "items": {"$ref": "engine-transcript-v1.schema.json"}},
          "selected_hypothesis": {"type": "integer", "minimum": 0},
          "optional_stage_failures": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
