{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchthrough.dev/schemas/corpus-v1.json",
  "title": "Patchthrough corrected corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpus_version", "name", "items"],
  "properties": {
    "corpus_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "private": { "type": "boolean" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "audio", "reference", "duration_seconds", "categories"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "audio": { "type": "string", "minLength": 1 },
          "reference": { "type": "string" },
          "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "silence_seconds": { "type": "number", "minimum": 0 },
          "categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "technical_terms": { "type": "array", "items": { "type": "string" } },
          "context_terms": { "type": "array", "items": { "type": "string" } },
          "readability_preference": { "enum": ["candidate", "baseline", "tie", "unscored"] }
        }
      }
    }
  }
}
